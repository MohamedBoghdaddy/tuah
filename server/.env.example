# ─── App / Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-a-long-random-session-secret
PORT=4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ─── Supabase ───────────────────────────────────────────────────────────────────
# Project URL from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co

# Anon / public key – safe to expose in browser builds if needed (not used here)
SUPABASE_ANON_KEY=

# Service role secret – BACKEND ONLY. Never expose in React / frontend code.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Supabase Storage Bucket Names ──────────────────────────────────────────────
# Create these buckets in Supabase Dashboard → Storage → Buckets
SUPABASE_PRODUCT_IMAGES_BUCKET=product-images
SUPABASE_PROFILE_IMAGES_BUCKET=profile-images
SUPABASE_EMPLOYEE_IMAGES_BUCKET=employee-images
SUPABASE_EMAIL_ATTACHMENTS_BUCKET=email-attachments

# ─── Email (sender identity) ────────────────────────────────────────────────────
EMAIL_FROM_NAME=Tuwa Commerce
EMAIL_FROM_ADDRESS=noreply@tuwacommerce.com

# ─── Email Delivery Provider (choose one or leave blank to queue-only) ───────────
# Option A – SMTP (nodemailer)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Option B – Resend  https://resend.com
RESEND_API_KEY=

# Option C – SendGrid  https://sendgrid.com
SENDGRID_API_KEY=
